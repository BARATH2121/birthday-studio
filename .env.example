# =============================================================================
# Birthday Studio — environment template (Phase 5 + Phase 6)
#
# Copy to `.env.local` and fill in the real values:
#   cp .env.example .env.local     (macOS / Linux)
#   Copy-Item .env.example .env.local   (PowerShell)
#
# `.env.local` is git-ignored. NEVER commit real values, and NEVER put a secret
# key in a NEXT_PUBLIC_ variable: those are inlined into the client bundle and
# are therefore public.
#
# Where to find these values:
#   Supabase dashboard -> Project Settings -> API
#   The URL is the project URL. The keys are the new-style keys; the older
#   `anon` and `service_role` values are deprecated and are not used here.
# =============================================================================

# --- Required: public, safe to ship to the browser ---------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key, e.g. sb_publishable_...
# This is a PUBLIC key. It is designed to be embedded in client code and is
# protected by Row Level Security, which is what keeps it safe.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Optional: server-only ---------------------------------------------------

# Secret key, e.g. sb_secret_...
#
# Used by exactly two code paths, both in app/actions/cleanup-orphan-photos.ts:
# cleanupOrphanedPhotos deletes photo uploads orphaned by a save the app could
# observe failing, and cleanupStaleOrphanedPhotos collects folders abandoned by a
# browser that disappeared mid-upload. The database grants `anon` no DELETE on
# storage.objects on purpose, so these are the only ways to clean up. Both verify
# that no live page references a folder before deleting it, and both refuse to run
# at all if this key is absent.
#
# Leave it empty and the app still works; nothing is ever deleted, so failed and
# abandoned saves leave files behind until a Storage lifecycle rule removes them
# (see docs/phase5-supabase-setup.md). Set it if you want cleanup.
SUPABASE_SECRET_KEY=

# --- Optional: scheduled cleanup ---------------------------------------------

# A long random string, e.g. `openssl rand -hex 32`. Server-only: never
# NEXT_PUBLIC_, because it authorises the expired-media sweep.
#
# The route at app/api/cron/expired/route.ts accepts it as either
# `Authorization: Bearer <value>` or an `x-cron-secret` header. If this variable
# is unset the route refuses every request and returns 503 -- deliberately,
# because "no secret configured" must never quietly degrade into "no
# authentication" on a route that deletes files.
#
# Two ways to call it:
#   * By hand: curl -H "Authorization: Bearer $CRON_SECRET" \
#       https://your-app.example/api/cron/expired
#   * On a schedule: install supabase/cron/expire-birthdays.sql, which reads
#     this same value out of Supabase Vault. The two must match exactly or every
#     request 401s.
#
# Leaving it empty is safe. Expired pages are already unreachable regardless --
# the public RPC filters on expires_at -- so this only controls *when* their
# Storage objects are reclaimed. See docs/phase6-abuse-and-cleanup.md.
CRON_SECRET=
